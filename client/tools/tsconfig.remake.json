{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "lib": [
      "ES2017",
      "DOM"
    ]
  },
  "include": [
    "../temp/declarations/*.d.ts",
    "../assets/scripts/**/*.ts",
    "bag-module-types-check.ts",
    "catalog-types-check.ts"
  ]
}
